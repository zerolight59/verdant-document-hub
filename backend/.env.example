APP_NAME=Verdant Document Hub
ENVIRONMENT=development

# ---- Verdant database (PostgreSQL) ----
VERDANT_DB_HOST=localhost
VERDANT_DB_PORT=5432
VERDANT_DB_USER=verdant_app
VERDANT_DB_PASSWORD=replace-with-a-strong-password
VERDANT_DB_NAME=verdant
VERDANT_DB_SSLMODE=prefer

# ---- Authentication and browser ----
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=480
FRONTEND_ORIGIN=http://localhost:3000

# ---- Document storage ----
STORAGE_ROOT=C:/VerdantData/documents
MAX_UPLOAD_SIZE_MB=100
